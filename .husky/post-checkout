#!/bin/sh
# Restore project skills from skills-lock.json when a checkout is missing any of them. Skills already in
# .claude/skills, including the ones git tracks for their local edits, are left as they are. Never blocks the checkout.
# When it runs: on a branch checkout, in a checkout where `npm install` has run. Git finds hooks through husky's
# core.hooksPath, `.husky/_`, which `npm install` creates and git ignores, so a new `git worktree add` runs no hook,
# this one included, until `npm install` runs there; then a branch checkout in it runs this.

[ "$3" = "1" ] || exit 0                      # branch checkouts only
[ -f skills-lock.json ] || exit 0
command -v node >/dev/null 2>&1 || exit 0
command -v npx >/dev/null 2>&1 || exit 0

missing=$(node -e '
  const fs = require("fs")
  const names = Object.keys(JSON.parse(fs.readFileSync("skills-lock.json", "utf8")).skills)
  console.log(names.filter((n) => !fs.existsSync(".claude/skills/" + n)).join(" "))
' 2>/dev/null) || exit 0
[ -n "$missing" ] || exit 0

echo "post-checkout: restoring skills from skills-lock.json..."
# experimental_install only writes to .agents/skills; Claude Code reads .claude/skills. Under CI (the factory's runner)
# it defaults to --frozen-lockfile, which refuses any lockfile it would rewrite; off it, it installs as on a dev machine.
if npx -y skills experimental_install --no-frozen-lockfile </dev/null >/dev/null 2>&1 && [ -d .agents/skills ]; then
  git checkout -q -- skills-lock.json 2>/dev/null || true   # the installer rewrites it; keep the committed one
  mkdir -p .claude/skills
  for name in $missing; do
    [ -d ".agents/skills/$name" ] && cp -R ".agents/skills/$name" ".claude/skills/$name"
  done
  echo "post-checkout: restored $(echo $missing | wc -w | tr -d ' ') skills"
else
  echo "post-checkout: skills restore failed; run mp_skills manually"
fi
exit 0
