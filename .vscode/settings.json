{
  // GitHub Pull Requests and Issues: queries match the triage labels in docs/agents/triage-labels.md
  "githubIssues.queries": [
    {
      // -is:blocked only works in GitHub's advanced search; if this list shows blocked tickets, the extension isn't using it
      "label": "Workable now",
      "query": "repo:${owner}/${repository} is:issue is:open label:ready-for-agent -label:in-progress -label:epic -is:blocked has:parent-issue sort:created-asc"
    },
    {
      "label": "v1 tickets (spec #6)",
      "query": "repo:${owner}/${repository} is:issue parent-issue:${owner}/${repository}#6 sort:created-asc"
    },
    {
      "label": "Epics",
      "query": "repo:${owner}/${repository} is:issue is:open label:epic sort:created-asc"
    },
    {
      "label": "Ready for agent",
      "query": "repo:${owner}/${repository} is:issue is:open label:ready-for-agent sort:created-asc"
    },
    {
      "label": "Ready for human",
      "query": "repo:${owner}/${repository} is:issue is:open label:ready-for-human sort:created-asc"
    },
    {
      "label": "Needs triage / info",
      "query": "repo:${owner}/${repository} is:issue is:open label:needs-triage,needs-info"
    },
    {
      "label": "My issues",
      "query": "repo:${owner}/${repository} is:issue is:open assignee:${user}"
    },
    {
      "label": "All open",
      "query": "repo:${owner}/${repository} is:issue is:open sort:created-asc"
    }
  ],
  "githubIssues.useBranchForIssues": "prompt",
  "githubIssues.issueBranchTitle": "issue-${issueNumber}-${sanitizedIssueTitle}",
  "githubPullRequests.queries": [
    {
      "label": "Waiting for my review",
      "query": "repo:${owner}/${repository} is:open review-requested:${user}"
    },
    {
      "label": "Mine",
      "query": "repo:${owner}/${repository} is:open author:${user}"
    },
    {
      "label": "All open",
      "query": "repo:${owner}/${repository} is:open"
    }
  ]
}
