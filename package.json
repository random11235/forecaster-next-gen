{
  "name": "forecaster",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run check:static && npm test",
    "check:ci": "npm run check:static && npm run test:coverage -- --exclude test/engine/benchmark.test.ts",
    "check:static": "npm run typecheck && npm run check:migrations && npm run check:changes -- ${CHECK_BASE:-origin/main}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "node scripts/mutateDiff.ts",
    "coverage:usage": "node scripts/usageCoverage.ts",
    "check:browser": "npm run build:web && node scripts/browserCheck.ts",
    "check:migrations": "node scripts/checkMigrations.ts",
    "start": "npm run build && node dist/app/main.js",
    "build:web": "npm run build && node scripts/buildWeb.ts",
    "record": "npm run build && node scripts/record.ts",
    "record:github": "npm run build && node scripts/record.ts github",
    "record:jira": "npm run build && node scripts/record.ts jira",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:changes": "node scripts/checkChanges.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "0.41.2",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2"
  }
}
