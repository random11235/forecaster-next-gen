{
  "name": "forecaster",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:usage": "node scripts/usageCoverage.ts",
    "check:migrations": "node scripts/checkMigrations.ts",
    "start": "npm run build && node dist/app/main.js",
    "build:web": "npm run build && node scripts/buildWeb.ts",
    "record": "npm run build && node scripts/record.ts",
    "record:github": "npm run build && node scripts/record.ts github",
    "record:jira": "npm run build && node scripts/record.ts jira",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:changes": "node scripts/checkChanges.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2"
  }
}
