#!/bin/sh
# Restore project skills from skills-lock.json when a checkout (e.g. a new
# worktree) has the lock file but no installed skills. Never blocks the checkout.
# Enable once per clone: git config core.hooksPath .githooks

[ "$3" = "1" ] || exit 0                      # branch checkouts only
[ -f skills-lock.json ] || exit 0
[ -d .claude/skills ] && exit 0
command -v npx >/dev/null 2>&1 || exit 0

echo "post-checkout: restoring skills from skills-lock.json..."
npx -y skills experimental_install </dev/null \
  || echo "post-checkout: skills restore failed; run mp_skills manually"
exit 0
